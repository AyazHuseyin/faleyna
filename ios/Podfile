# Resolve react_native_pods.rb with node (works with hoisted node_modules)
require Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]
).strip

# Expo autolinking for bare workflow
expo_autolinking_script = Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("expo/package.json", {paths: [process.argv[1], process.cwd(), process.cwd() + "/.."]})', __dir__]
).strip
require File.join(File.dirname(expo_autolinking_script), 'scripts/autolinking')

$RNFirebaseAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, '15.1'
prepare_react_native_project!

target 'faleyna' do
  use_expo_modules!

  config = use_native_modules!
  use_frameworks! linkage: :static

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    rn_root = File.expand_path(config[:reactNativePath], Pod::Config.instance.installation_root)
    react_common = File.join(rn_root, 'ReactCommon')
    react_common_dest = File.join(installer.sandbox.root, 'Headers', 'Public', 'ReactCommon', 'ReactCommon')
    react_core_react_dest = File.join(installer.sandbox.root, 'Headers', 'Public', 'React-Core', 'React')
    react_public_dest = File.join(installer.sandbox.root, 'Headers', 'Public', 'React')
    fabric_root = File.join(rn_root, 'React', 'Fabric')
    fabric_mounting = File.join(fabric_root, 'Mounting')
    fabric_surface = File.join(fabric_root, 'Surface')
    react_root = File.join(rn_root, 'React')
    react_core_header_root = File.join(installer.sandbox.root, 'Headers', 'Public', 'React-Core', 'React')

    universal_headers = [
      '$(inherited)',
      '$(PODS_ROOT)/Headers/Public',
      '$(PODS_ROOT)/Headers/Private',
      '"${PODS_CONFIGURATION_BUILD_DIR}/**"',
      '$(PODS_ROOT)/React-Core/React',
      '$(PODS_ROOT)/React-Core/React/Fabric',
      '$(PODS_ROOT)/React-Core/React/Fabric/Mounting',
      "\"#{react_common}\"",
      "\"#{File.join(react_common, 'runtimeexecutor')}\"",
      "\"#{File.join(react_common, 'runtimeexecutor', 'ReactCommon')}\"",
      '"${PODS_CONFIGURATION_BUILD_DIR}/ReactCommon/ReactCommon.framework/Headers"',
      '$(PODS_ROOT)/Headers/Public/React',
      "\"#{react_root}\"",
      "\"#{fabric_root}\"",
      "\"#{fabric_mounting}\"",
      "\"#{fabric_surface}\""
    ].join(' ')

    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        cfg.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        cfg.build_settings['HEADER_SEARCH_PATHS'] = "#{universal_headers} $(inherited)"
        cfg.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        cfg.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cfg.build_settings['OTHER_SWIFT_FLAGS'] = [
          cfg.build_settings['OTHER_SWIFT_FLAGS'] || '',
          '-Xfrontend', '-warn-concurrency',
          '-Xfrontend', '-enable-actor-data-race-checks',
          '-Xfrontend', '-disable-availability-checking'
        ].join(' ').strip
        cfg.build_settings['OTHER_CFLAGS'] = [
          cfg.build_settings['OTHER_CFLAGS'] || '$(inherited)',
          '-isystem $(PODS_ROOT)/RCT-Folly',
          '-isystem $(PODS_ROOT)/boost',
          '-isystem $(PODS_ROOT)/DoubleConversion',
          '-isystem $(PODS_ROOT)/fmt/include',
          "-isystem \"#{react_common}\"",
          "-isystem \"#{File.join(react_common, 'runtimeexecutor')}\"",
          "-isystem \"#{File.join(react_common, 'runtimeexecutor', 'ReactCommon')}\"",
          "-isystem \"#{react_root}\"",
          "-isystem \"#{fabric_root}\"",
          "-isystem \"#{fabric_mounting}\"",
          "-isystem \"#{fabric_surface}\""
        ].join(' ')
      end

      # Disable modules for React* source pods to allow non-exported headers (e.g., RCTComponentViewFactory)
      if t.name =~ /^(ReactCommon|React-runtimescheduler|React-runtime|React-debug|React-utils|React-perflogger|React-renderer|React-Mapbuffer)/
        t.build_configurations.each do |cfg|
          cfg.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      else
        t.build_configurations.each do |cfg|
          cfg.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
      end
    end

    # Copy all ReactCommon headers into Public so <ReactCommon/...> resolves under use_frameworks
    if File.directory?(react_common)
      FileUtils.mkdir_p(react_common_dest)
      Dir.glob(File.join(react_common, '**', '*.h')).each do |hdr|
        FileUtils.cp(hdr, File.join(react_common_dest, File.basename(hdr)))
      end
    end

    # Expose Fabric headers (e.g., RCTComponentViewFactory) under React/ for use_frameworks
    if File.directory?(fabric_root)
      FileUtils.mkdir_p(react_core_react_dest)
      FileUtils.mkdir_p(react_public_dest)
      Dir.glob(File.join(fabric_root, '*.h')).each do |hdr|
        FileUtils.cp(hdr, File.join(react_core_react_dest, File.basename(hdr)))
        FileUtils.cp(hdr, File.join(react_public_dest, File.basename(hdr)))
      end
    end
    if File.directory?(fabric_mounting)
      FileUtils.mkdir_p(react_core_react_dest)
      FileUtils.mkdir_p(react_public_dest)
      Dir.glob(File.join(fabric_mounting, '*.h')).each do |hdr|
        FileUtils.cp(hdr, File.join(react_core_react_dest, File.basename(hdr)))
        FileUtils.cp(hdr, File.join(react_public_dest, File.basename(hdr)))
      end
    end
    if File.directory?(fabric_surface)
      FileUtils.mkdir_p(react_core_react_dest)
      FileUtils.mkdir_p(react_public_dest)
      Dir.glob(File.join(fabric_surface, '*.h')).each do |hdr|
        FileUtils.cp(hdr, File.join(react_core_react_dest, File.basename(hdr)))
        FileUtils.cp(hdr, File.join(react_public_dest, File.basename(hdr)))
      end
    end
    # Copy all React/.h headers (shallow) into React-Core public headers to satisfy <React/...>
    if File.directory?(react_root)
      FileUtils.mkdir_p(react_core_react_dest)
      FileUtils.mkdir_p(react_public_dest)
      Dir.glob(File.join(react_root, '*.h')).each do |hdr|
        FileUtils.cp(hdr, File.join(react_core_react_dest, File.basename(hdr)))
        FileUtils.cp(hdr, File.join(react_public_dest, File.basename(hdr)))
      end
    end

    # Explicitly copy key Fabric headers that trigger failures
    %w[RCTComponentViewFactory.h RCTSurfacePresenter.h].each do |file|
      source_paths = [
        File.join(fabric_mounting, file),
        File.join(fabric_root, file),
        File.join(fabric_surface, file),
        File.join(react_root, file)
      ]
      src = source_paths.find { |p| File.exist?(p) }
      next unless src
      FileUtils.mkdir_p(react_core_header_root)
      FileUtils.cp(src, File.join(react_core_header_root, file))
      FileUtils.mkdir_p(react_public_dest)
      FileUtils.cp(src, File.join(react_public_dest, file))
    end

    # --- Patch expo-modules-core Swift concurrency issues (no network/pod edits) ---
    patches = {
      File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'ReactDelegates', 'ExpoReactDelegate.swift') => {
        find: "@objc(EXReactDelegate)\npublic class ExpoReactDelegate: NSObject {",
        replace: "@MainActor\n@objc(EXReactDelegate)\npublic class ExpoReactDelegate: NSObject {"
      },
      File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'Core', 'Logging', 'PersistentFileLog.swift') => {
        find: "public typealias PersistentFileLogFilter = (String) -> Bool",
        replace: "public typealias PersistentFileLogFilter = @Sendable (String) -> Bool"
      },
      File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'Core', 'Views', 'SwiftUI', 'SwiftUIHostingView.swift') => {
        find: "internal protocol AnyExpoSwiftUIHostingView {",
        replace: "@MainActor\ninternal protocol AnyExpoSwiftUIHostingView {"
      },
      File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'Core', 'Views', 'SwiftUI', 'SwiftUIVirtualView.swift') => {
        find: "final class SwiftUIVirtualView<Props: ViewProps, ContentView: View<Props>>: SwiftUIVirtualViewObjC, ExpoSwiftUIView {",
        replace: "@MainActor\n  final class SwiftUIVirtualView<Props: ViewProps, ContentView: View<Props>>: SwiftUIVirtualViewObjC, ExpoSwiftUIView {"
      },
      File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'DevTools', 'URLAuthenticationChallengeForwardSender.swift') => {
        find: "  let completionHandler: (URLSession.AuthChallengeDisposition, URLCredential?) -> Void",
        replace: "  let completionHandler: @Sendable (URLSession.AuthChallengeDisposition, URLCredential?) -> Void"
      }
    }

    patches.each do |path, ops|
      next unless File.exist?(path)
      content = File.read(path)
      next if content.include?(ops[:replace])
      File.write(path, content.sub(ops[:find], ops[:replace]))
    end

    # Add @Sendable init param in URLAuthenticationChallengeForwardSender.swift
    sender_path = File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'DevTools', 'URLAuthenticationChallengeForwardSender.swift')
    if File.exist?(sender_path)
      content = File.read(sender_path)
      unless content.include?("@Sendable (URLSession.AuthChallengeDisposition, URLCredential?) -> Void) {")
        content = content.sub(
          "  init(completionHandler: @escaping (URLSession.AuthChallengeDisposition, URLCredential?) -> Void) {",
          "  init(completionHandler: @escaping @Sendable (URLSession.AuthChallengeDisposition, URLCredential?) -> Void) {"
        )
        File.write(sender_path, content)
      end
    end

    # Append unchecked Sendable to URLSessionSessionDelegateProxy and URLAuthenticationChallengeForwardSender
    proxy_path = File.join(installer.sandbox.root, '..', 'node_modules', 'expo-modules-core', 'ios', 'DevTools', 'URLSessionSessionDelegateProxy.swift')
    if File.exist?(proxy_path)
      content = File.read(proxy_path)
      unless content.include?("extension URLSessionSessionDelegateProxy: @unchecked Sendable {}")
        content << "\n\nextension URLSessionSessionDelegateProxy: @unchecked Sendable {}\nextension URLAuthenticationChallengeForwardSender: @unchecked Sendable {}\n"
        File.write(proxy_path, content)
      end
    end
  end
end
