# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Expo (EAS): ExpoModulesCore pod + autolinking — https://docs.expo.dev/bare/installing-expo-modules/
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

# firebase-ios-sdk v9+ / RN Firebase: statik framework + use_frameworks (modül haritası için zorunlu)
# https://rnfirebase.io/#altering-cocoapods-to-use-frameworks
$RNFirebaseAsStaticFramework = true

# Yeni mimari kapalı (Fabric + Firebase static frameworks ile EAS'te header yolu kırılmalarını önlemek için).
# ÖNEMLİ: EAS/Expo build ortamı RCT_NEW_ARCH_ENABLED=1 verebilir; ||= buna saygı duyar ve 1 bırakır —
# o zaman react/renderer/... başlıkları eksik kalır ('DebugStringConvertible.h' not found). Sabitle:
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'faleyna' do
  use_expo_modules!

  config = use_native_modules!

  # RN Firebase / firebase-ios-sdk: aksi halde "Module 'FirebaseCore' not found" (ör. FirebaseInstallations)
  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 16+: bazı pod'lar 9.0/10.0 bırakıyor; uyarı ve link sorunlarını azaltır
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        t = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if t.nil? || t.to_f < 12.0
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
        end
      end
    end
  end
end
