# Resolve react_native_pods.rb with node (works with hoisted node_modules)
require Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})', __dir__]
).strip

# Expo autolinking for bare workflow (resolve even when running from ios/)
expo_autolinking_script = Pod::Executable.execute_command(
  'node',
  ['-p', 'require.resolve("expo/package.json", {paths: [process.argv[1], process.cwd(), process.cwd() + "/.."]})', __dir__]
).strip
require File.join(File.dirname(expo_autolinking_script), 'scripts/autolinking')

# RN Firebase needs static frameworks when use_frameworks! is enabled
$RNFirebaseAsStaticFramework = true

# Keep classic architecture; Expo build env might force 1, so pin it here
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, '15.1'
prepare_react_native_project!

target 'faleyna' do
  use_expo_modules!

  config = use_native_modules!
  use_frameworks! linkage: :static

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    rn_root = File.expand_path(config[:reactNativePath], Pod::Config.instance.installation_root)
    react_common = File.join(rn_root, 'ReactCommon')
    react_featureflags = File.join(react_common, 'react', 'featureflags')
    react_codegen_generated = File.join(rn_root, 'React', 'FBReactNativeSpec', 'Generated')
    hermes_headers = '$(PODS_ROOT)/hermes-engine/destroot/include'
    folly_sandbox = File.join(installer.sandbox.root, 'RCT-Folly')
    folly_framework_headers = '"${PODS_CONFIGURATION_BUILD_DIR}/RCT-Folly/folly.framework/Headers"'
    reactcommon_framework_headers = '"${PODS_CONFIGURATION_BUILD_DIR}/ReactCommon/ReactCommon.framework/Headers"'
    runtimeexecutor_root = "\"#{File.join(react_common, 'runtimeexecutor')}\""
    runtimeexecutor_sub = "\"#{File.join(react_common, 'runtimeexecutor', 'ReactCommon')}\""
    runtimeexecutor_ios_root = "\"#{File.join(react_common, 'runtimeexecutor', 'platform', 'ios')}\""
    turbomodule_core_root = "\"#{File.join(react_common, 'turbomodule', 'core')}\""
    turbomodule_core_platform_ios = "\"#{File.join(react_common, 'turbomodule', 'core', 'platform', 'ios', 'ReactCommon')}\""
    boost_headers = '$(PODS_ROOT)/boost'
    double_conversion_headers = '$(PODS_ROOT)/DoubleConversion'
    fmt_headers = '$(PODS_ROOT)/fmt/include'
    additional_common_headers = [
      "\"#{react_common}\"",
      "\"#{File.join(react_common, 'callinvoker')}\"",
      "\"#{File.join(react_common, 'callinvoker', 'ReactCommon')}\"",
      "\"#{File.join(react_common, 'react')}\"",
      "\"#{File.join(react_common, 'react', 'debug')}\"",
      "\"#{File.join(react_common, 'react', 'renderer')}\"",
      "\"#{react_featureflags}\"",
      runtimeexecutor_root,
      runtimeexecutor_sub,
      runtimeexecutor_ios_root,
      turbomodule_core_root,
      turbomodule_core_platform_ios,
      reactcommon_framework_headers
    ].join(' ')
    additional_third_party_headers = [
      '$(PODS_ROOT)/RCT-Folly',
      "\"#{folly_sandbox}\"",
      folly_framework_headers,
      boost_headers,
      double_conversion_headers,
      fmt_headers
    ].join(' ')

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['SWIFT_VERSION'] = '5.9'
        cfg.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

        headers = cfg.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        headers = headers.to_s
        headers = "$(inherited) #{headers}" unless headers.include?('$(inherited)')
        cfg.build_settings['HEADER_SEARCH_PATHS'] = "#{headers} #{additional_common_headers} #{additional_third_party_headers}"
        oc = cfg.build_settings['OTHER_CFLAGS'] || '$(inherited)'
        cfg.build_settings['OTHER_CFLAGS'] =
          "#{oc} -isystem \"#{folly_sandbox}\" -isystem $(PODS_ROOT)/RCT-Folly -isystem #{boost_headers} -isystem #{double_conversion_headers} -isystem #{fmt_headers} -isystem \"#{File.join(react_common, 'callinvoker')}\" -isystem \"#{File.join(react_common, 'callinvoker', 'ReactCommon')}\" -isystem #{runtimeexecutor_root} -isystem #{runtimeexecutor_sub} -isystem #{runtimeexecutor_ios_root} -isystem #{turbomodule_core_root} -isystem #{turbomodule_core_platform_ios}"
        unless cfg.build_settings['HEADER_SEARCH_PATHS'].to_s.include?(react_featureflags)
          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} \"#{react_featureflags}\""
        end

        if %w[FirebaseCoreInternal GoogleUtilities FirebaseFirestoreInternal].include?(target.name)
          cfg.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        end
      end

      if target.name == 'React-rendererdebug'
        target.build_configurations.each do |cfg|
          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} \"#{react_common}\" $(PODS_ROOT)/DoubleConversion"
        end
      end

      if %w[ExpoModulesJSI ExpoModulesCore].include?(target.name)
        extra_headers = [
          "\"#{react_common}\"",
          "\"#{File.join(react_common, 'callinvoker')}\"",
          "\"#{File.join(react_common, 'runtimeexecutor')}\"",
          "\"#{File.join(react_common, 'react', 'nativemodule', 'core')}\"",
          "\"#{react_featureflags}\"",
          "\"#{react_codegen_generated}\"",
          hermes_headers
        ].join(' ')

        target.build_configurations.each do |cfg|
          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} #{extra_headers}"
        end
      elsif target.name.include?('React-featureflags')
        target.build_configurations.each do |cfg|
          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} \"#{react_common}\" \"#{react_featureflags}\""
        end
      end

      if target.name.include?('jsinspector')
        # jsinspector-modern tracing headers under ReactCommon/jsinspector-modern
        jsinspector_headers = [
          "\"#{react_common}\"",
          "\"#{File.join(react_common, 'jsinspector-modern')}\"",
          "\"#{File.join(react_common, 'jsinspector-modern', 'tracing')}\""
        ].join(' ')
        target.build_configurations.each do |cfg|
          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} #{jsinspector_headers} $(PODS_ROOT)/RCT-Folly \"#{folly_sandbox}\" \"${PODS_CONFIGURATION_BUILD_DIR}/RCT-Folly/folly.framework/Headers\" $(PODS_ROOT)/boost $(PODS_ROOT)/DoubleConversion $(PODS_ROOT)/fmt/include"
          other_cflags = cfg.build_settings['OTHER_CFLAGS'] || '$(inherited)'
          cfg.build_settings['OTHER_CFLAGS'] =
            "#{other_cflags} -isystem \"#{folly_sandbox}\" -isystem \"$(PODS_ROOT)/RCT-Folly\" -isystem \"$(PODS_ROOT)/boost\" -isystem \"$(PODS_ROOT)/DoubleConversion\" -isystem \"$(PODS_ROOT)/fmt/include\""
        end
      else
        target.build_configurations.each do |cfg|
          next if cfg.build_settings['HEADER_SEARCH_PATHS'].to_s.include?(folly_sandbox)

          cfg.build_settings['HEADER_SEARCH_PATHS'] =
            "#{cfg.build_settings['HEADER_SEARCH_PATHS']} $(PODS_ROOT)/RCT-Folly \"#{folly_sandbox}\" \"${PODS_CONFIGURATION_BUILD_DIR}/RCT-Folly/folly.framework/Headers\""
          other_cflags = cfg.build_settings['OTHER_CFLAGS'] || '$(inherited)'
          cfg.build_settings['OTHER_CFLAGS'] =
            "#{other_cflags} -isystem \"#{folly_sandbox}\" -isystem \"$(PODS_ROOT)/RCT-Folly\""
        end
      end
    end
  end
end
